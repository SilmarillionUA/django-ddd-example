{
  "permissions": {
    "allow": [
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(make format:*)",
      "Bash(make architecture:*)",
      "Bash(make check_db:*)",
      "Bash(python -m pytest:*)",
      "Bash(python src/manage.py check:*)",
      "Bash(python src/manage.py makemigrations:*)",
      "Bash(python src/manage.py showmigrations:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(python src/manage.py migrate:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./src/project_src/settings/local.py)",
      "Read(./src/project_src/settings/production.py)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/safety_check.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/auto_format.py"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ddd_layer_guard.py"
          }
        ]
      }
    ]
  }
}
