{
  "permissions": {
    "allow": [
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(make format:*)",
      "Bash(make architecture:*)",
      "Bash(make check_db:*)",
      "Bash(python -m pytest:*)",
      "Bash(python src/manage.py check:*)",
      "Bash(python src/manage.py makemigrations:*)",
      "Bash(python src/manage.py showmigrations:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(python src/manage.py migrate:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./src/project_src/settings/local.py)",
      "Read(./src/project_src/settings/production.py)"
    ]
  },
  "extraKnownMarketplaces": {
    "django-ddd-claude-plugin": {
      "source": {
        "source": "github",
        "repo": "SilmarillionUA/django-ddd-claude-plugin"
      }
    }
  },
  "enabledPlugins": {
    "django-ddd@django-ddd-claude-plugin": true
  }
}
